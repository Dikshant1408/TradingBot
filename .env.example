# Application Mode: backtest | paper | live
# NOTE: live mode is strictly DISABLED by default and requires preflight confirmation
APP_MODE=paper

# Server Settings
HOST=127.0.0.1
PORT=8000
DEBUG=False
SECRET_KEY=change-this-to-a-secure-random-string-in-production

# Timezone (Display in IST, stored in UTC)
TIMEZONE=Asia/Kolkata

# Initial Virtual Capital (INR)
INITIAL_CAPITAL=100000.0

# Risk Management Limits (INR / percentages / counts)
MAX_DAILY_LOSS=5000.0
MAX_DRAWDOWN_PERCENT=0.05
MAX_TRADES_PER_DAY=5
MAX_POSITION_SIZE_VALUE=50000.0
MAX_OPEN_POSITIONS=3
KILL_SWITCH=False

# Indian Market Cost Parameters (Defaults for NSE Equity Intraday)
DEFAULT_BROKERAGE_PER_ORDER=20.0
DEFAULT_STT_RATE=0.00025
DEFAULT_EXCHANGE_TURNOVER_RATE=0.0000297
DEFAULT_GST_RATE=0.18
DEFAULT_SEBI_RATE=0.000001
DEFAULT_STAMP_DUTY_RATE=0.00003
DEFAULT_SLIPPAGE_PCT=0.0005

# Optional Telegram Notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=False

# Broker Credentials (OPTIONAL - only if live trading is explicitly configured)
# Do NOT fill these until paper trading and backtesting are verified
BROKER_NAME=
BROKER_API_KEY=
BROKER_API_SECRET=
BROKER_USER_ID=
BROKER_PASSWORD=
BROKER_TOTP_KEY=
